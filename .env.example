# Learn English — standalone app

# PostgreSQL Connection (separate database for learn_english)
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/learn_english?schema=public"
PG_POOL_MAX=5
PG_IDLE_TIMEOUT_MS=30000

# MongoDB Connection (NextAuth users & sessions)
MONGODB_URI="mongodb://localhost:27018/learn_english"

# NextAuth Configuration
AUTH_SECRET="your-auth-secret-min-32-chars-replace-in-production"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3002"

# Google OAuth Credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Admin emails (comma-separated)
ADMIN_EMAILS="admin@example.com"

# Link to sister Chinese app
NEXT_PUBLIC_CHINESE_URL="http://localhost:3001"

# Optional directory containing imported English audio files
ENGLISH_AUDIO_ROOT=""

# Docker Compose service credentials (use strong production values)
POSTGRES_USER=learn_english
POSTGRES_PASSWORD=change-me
POSTGRES_DB=learn_english
MONGO_ROOT_USERNAME=learn_english
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=learn_english_auth
APP_PORT=3002

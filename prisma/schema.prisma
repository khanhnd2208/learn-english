// Learn English — standalone vocabulary app (PostgreSQL)
// userId references MongoDB User._id via NextAuth

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EnContentStatus {
  draft
  published
  suspended
}

enum EnRunMode {
  set
  mistakes
  review
}

enum EnTestStatus {
  in_progress
  finished
  abandoned
}

enum EnExampleRole {
  study
  grade
}

model EnWord {
  id           String          @id @default(cuid())
  lemma        String
  lemmaKey     String          @unique
  partOfSpeech String          @default("")
  ipa          String          @default("")
  audioPath    String          @default("")
  forms        String[]        @default([])
  status       EnContentStatus @default(draft)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  senses       EnSense[]

  @@index([status])
  @@index([lemma])
}

model EnSense {
  id           String          @id @default(cuid())
  wordId       String
  senseKey     String?         @unique
  meaningVi    String
  partOfSpeech String          @default("")
  /// Accepted near-synonyms do not change the learner's schedule.
  synonyms     String[]        @default([])
  /// Short Vietnamese usage note.
  noteVi       String          @default("")
  /// Optional advanced reading: [{ kind, phrase, meaningVi, example }] (see advancedNotes.ts).
  advanced     Json            @default("[]")
  /// Same-family words: [{ word, partOfSpeech, meaningVi }] (see wordFamily.ts).
  family       Json            @default("[]")
  status       EnContentStatus @default(draft)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  word         EnWord          @relation(fields: [wordId], references: [id], onDelete: Cascade)
  examples     EnExample[]
  wordStates   EnWordState[]
  setItems     EnSetItem[]

  @@index([wordId])
  @@index([status])
}

model EnExample {
  id           String          @id @default(cuid())
  senseId      String
  english      String
  meaningVi    String          @default("")
  target       String
  targetStart  Int?
  targetLength Int?
  /// The first study example is the one shown on the card; grade examples are hidden quiz sentences.
  role         EnExampleRole   @default(study)
  status       EnContentStatus @default(draft)
  sortOrder    Int             @default(0)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sense        EnSense         @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@index([senseId, status, role])
}

model EnSet {
  id          String          @id @default(cuid())
  title       String
  description String          @default("")
  status      EnContentStatus @default(draft)
  listed      Boolean         @default(true)
  accessCode  String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       EnSetItem[]
  enrollments EnEnrollment[]

  @@index([status, sortOrder])
}

model EnSetItem {
  id       String   @id @default(cuid())
  setId    String
  senseId  String?
  position Int      @default(0)
  set      EnSet    @relation(fields: [setId], references: [id], onDelete: Cascade)
  sense    EnSense? @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@index([setId, position])
  @@index([senseId])
}

model EnEnrollment {
  id        String   @id @default(cuid())
  userId    String
  setId     String
  createdAt DateTime @default(now())
  set       EnSet    @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([userId, setId])
  @@index([userId])
}

model EnReviewPreference {
  userId         String   @id
  selectedSetIds String[] @default([])
  initializedAt  DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EnGuidedReviewSession {
  id                   String                   @id @default(cuid())
  userId               String
  activeKey            String?                  @unique
  selectedSetIds       String[]                 @default([])
  poolSenseIds         String[]                 @default([])
  remainingSenseIds    String[]                 @default([])
  currentChunkSenseIds String[]                 @default([])
  chunkNumber          Int                      @default(1)
  phase                String                   @default("study")
  studyPosition        Int                      @default(0)
  questionPosition     Int                      @default(0)
  startedAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  endedAt              DateTime?
  activeSeconds        Int                      @default(0)
  questions            EnGuidedReviewQuestion[]

  @@index([userId, startedAt])
}

model EnGuidedReviewQuestion {
  id          String                @id @default(cuid())
  sessionId   String
  chunkNumber Int
  kind        String                @default("main")
  position    Int
  senseId     String
  role        String
  activityKey String
  prompt      Json
  answerKey   String
  accepted    String[]              @default([])
  layout      Json?
  answer      String?
  correct     Boolean?
  responseMs  Int?
  answeredAt  DateTime?
  session     EnGuidedReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, chunkNumber, kind, position])
  @@unique([sessionId, chunkNumber, kind, senseId])
  @@index([sessionId, chunkNumber, kind])
  @@index([sessionId, senseId])
}

model EnWordState {
  id             String    @id @default(cuid())
  userId         String
  senseId        String
  box            Int       @default(0)
  dueAt          DateTime  @default(now())
  lapses         Int       @default(0)
  introducedAt   DateTime  @default(now())
  lastReviewedAt DateTime?
  updatedAt      DateTime  @updatedAt
  sense          EnSense   @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@unique([userId, senseId])
  @@index([userId, dueAt])
}

model EnReview {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String
  senseId    String
  at         DateTime @default(now())
  prompt     String
  correct    Boolean
  responseMs Int      @default(0)
  boxBefore  Int
  boxAfter   Int
  /// False for answers that did not move the schedule (in-session retries, answers before the due date).
  scheduled  Boolean  @default(true)

  @@index([userId, at])
  @@index([userId, senseId, at])
  @@index([sessionId])
}

/// A learner's claim that a wrong SRS answer was also correct. Admin accepts or rejects it;
/// accepting undoes the schedule penalty of that review.
model EnAnswerAppeal {
  id         String    @id @default(cuid())
  reviewId   String    @unique
  userId     String
  userName   String    @default("")
  userEmail  String    @default("")
  senseId    String
  answer     String
  expected   String
  note       String    @default("")
  /// pending | accepted | rejected
  status     String    @default("pending")
  /// True when accepting moved the learner's schedule back up.
  restored   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?
  resolvedBy String?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model EnPracticeSession {
  id            String    @id @default(cuid())
  userId        String
  mode          EnRunMode
  setId         String?
  activityKey   String?
  senseIds      String[]  @default([])
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  activeSeconds Int       @default(0)

  @@index([userId, startedAt])
}

model EnTestAttempt {
  id          String       @id @default(cuid())
  userId      String
  mode        EnRunMode
  setId       String?
  blueprint   Json
  status      EnTestStatus @default(in_progress)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  wordCount   Int
  passedCount Int?
  items       EnTestItem[]

  @@index([userId, startedAt])
}

model EnLearnerProfile {
  userId            String    @id
  weeklyDaysGoal    Int       @default(4)
  /// Daily XP target. A change shows up in the next daily quest board.
  dailyXpGoal       Int       @default(400)
  /// Null until the learner picks a daily goal; drives the one-time goal picker.
  dailyGoalChosenAt DateTime?
  /// Highest level the learner has been congratulated for.
  seenLevel         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// XP ledger. Every source has a stable key, so a repeated answer, retake or replay never pays twice.
model EnXpEvent {
  id        String   @id @default(cuid())
  userId    String
  sourceKey String
  /// review | new (legacy) | longterm | extra | quiz | quest | goal | chest | achievement
  kind      String
  xp        Int
  /// Vietnam calendar day, YYYY-MM-DD.
  day       String
  at        DateTime @default(now())

  @@unique([userId, sourceKey])
  @@index([userId, day])
  @@index([userId, kind])
}

/// Quests fixed for one day or week, so targets do not move while the learner works on them.
model EnQuestBoard {
  userId    String
  /// daily | weekly
  period    String
  /// Day key, or the Monday day key for a week.
  periodKey String
  /// Array of { key, target, xp }.
  quests    Json
  createdAt DateTime @default(now())

  @@id([userId, period, periodKey])
}

model EnAchievement {
  userId     String
  /// Achievement id plus tier, e.g. memory_vault_2.
  key        String
  unlockedAt DateTime  @default(now())
  seenAt     DateTime?

  @@id([userId, key])
}

model EnTestItem {
  id          String        @id @default(cuid())
  attemptId   String
  senseId     String
  position    Int
  role        String
  activityKey String
  prompt      Json
  answerKey   String
  accepted    String[]      @default([])
  answer      String?
  correct     Boolean?
  responseMs  Int?
  answeredAt  DateTime?
  attempt     EnTestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, position])
  @@index([attemptId, senseId])
}

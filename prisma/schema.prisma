// Learn English — standalone vocabulary app (PostgreSQL)
// userId references MongoDB User._id via NextAuth

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EnContentStatus {
  draft
  published
  suspended
}

enum EnRunMode {
  set
  mistakes
  review
}

enum EnTestStatus {
  in_progress
  finished
  abandoned
}

enum EnExampleRole {
  study
  grade
}

enum EnCefr {
  pre_a1
  a1
  a2
  b1
  b2
  c1
  c2
}

enum EnEntryType {
  word
  phrasal_verb
  idiom
  fixed_phrase
}

enum EnRegister {
  neutral
  formal
  informal
  slang
  literary
  technical
  old_fashioned
  offensive
}

enum EnRegion {
  both
  uk
  us
}

enum EnContentOrigin {
  authored
  ai_generated
  corpus
}

enum EnHintKind {
  category
  function
  context
  association
  contrast
  morphology
}

enum EnRelationKind {
  synonym
  antonym
  broader
  narrower
  confusable
}

enum EnConfusableType {
  spelling
  sound
  meaning
  false_friend
  grammar
  collocation
}

enum EnFamilyKind {
  derivation
  root
}

model EnWord {
  id            String               @id @default(cuid())
  lemma         String
  ipa           String               @default("")
  stress        String               @default("")
  partOfSpeech  String               @default("")
  forms         String[]             @default([])
  audioPath     String               @default("")
  status        EnContentStatus      @default(draft)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  lemmaKey      String               @unique
  entryType     EnEntryType          @default(word)
  ipaUk         String               @default("")
  ipaUs         String               @default("")
  syllables     String[]             @default([])
  stressIndex   Int?
  inflections   Json                 @default("[]")
  frequencyRank Int?
  cefr          EnCefr?
  audioUkPath   String               @default("")
  audioUsPath   String               @default("")
  senses        EnSense[]
  familyLinks   EnWordFamilyMember[]

  @@index([status])
  @@index([lemma])
  @@index([cefr])
  @@index([frequencyRank])
}

model EnSense {
  id                  String            @id @default(cuid())
  wordId              String
  meaningVi           String
  partOfSpeech        String            @default("")
  pitfallVi           String            @default("")
  chunks              Json              @default("[]")
  commonErrors        Json              @default("[]")
  distractorMeanings  String[]          @default([])
  distractorLemmas    String[]          @default([])
  isPrimary           Boolean           @default(true)
  status              EnContentStatus   @default(draft)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  senseKey            String?           @unique
  definitionEn        String            @default("")
  definitionEnSimple  String            @default("")
  cefr                EnCefr?
  register            EnRegister        @default(neutral)
  region              EnRegion          @default(both)
  topics              String[]          @default([])
  grammarTags         String[]          @default([])
  grammarNoteVi       String            @default("")
  ipaOverride         String            @default("")
  stressIndexOverride Int?
  imagePath           String            @default("")
  imageAlt            String            @default("")
  sortOrder           Int               @default(0)
  word                EnWord            @relation(fields: [wordId], references: [id], onDelete: Cascade)
  examples            EnExample[]
  wordStates          EnWordState[]
  setItems            EnSetItem[]
  hints               EnSenseHint[]
  relations           EnSenseRelation[] @relation("SenseRelationFrom")
  relatedFrom         EnSenseRelation[] @relation("SenseRelationTo")

  @@index([wordId])
  @@index([status])
  @@index([cefr])
}

model EnExample {
  id            String          @id @default(cuid())
  senseId       String
  english       String
  meaningVi     String          @default("")
  target        String
  audioPath     String          @default("")
  role          EnExampleRole   @default(study)
  alternatives  String[]        @default([])
  ambiguityNote String          @default("")
  status        EnContentStatus @default(draft)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  targetStart   Int?
  targetLength  Int?
  targetTag     String          @default("")
  cefr          EnCefr?
  origin        EnContentOrigin @default(authored)
  sourceNote    String          @default("")
  sortOrder     Int             @default(0)
  sense         EnSense         @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@index([senseId, status, role])
}

model EnSenseHint {
  id        String          @id @default(cuid())
  senseId   String
  order     Int
  kind      EnHintKind
  textEn    String
  textVi    String          @default("")
  cefr      EnCefr?
  status    EnContentStatus @default(draft)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  sense     EnSense         @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@unique([senseId, order])
  @@index([senseId, status])
}

model EnSenseRelation {
  id             String            @id @default(cuid())
  senseId        String
  kind           EnRelationKind
  lemma          String
  targetSenseId  String?
  confusableType EnConfusableType?
  noteVi         String            @default("")
  contrast       Json              @default("[]")
  mistake        Json?
  sortOrder      Int               @default(0)
  createdAt      DateTime          @default(now())
  sense          EnSense           @relation("SenseRelationFrom", fields: [senseId], references: [id], onDelete: Cascade)
  targetSense    EnSense?          @relation("SenseRelationTo", fields: [targetSenseId], references: [id], onDelete: SetNull)

  @@unique([senseId, kind, lemma])
  @@index([targetSenseId])
}

model EnWordFamily {
  id         String               @id @default(cuid())
  key        String               @unique
  kind       EnFamilyKind
  root       String
  meaningVi  String               @default("")
  meaningEn  String               @default("")
  originNote String               @default("")
  status     EnContentStatus      @default(draft)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  members    EnWordFamilyMember[]
}

model EnWordFamilyMember {
  id           String       @id @default(cuid())
  familyId     String
  lemma        String
  wordId       String?
  partOfSpeech String       @default("")
  affixNote    String       @default("")
  meaningVi    String       @default("")
  sortOrder    Int          @default(0)
  family       EnWordFamily @relation(fields: [familyId], references: [id], onDelete: Cascade)
  word         EnWord?      @relation(fields: [wordId], references: [id], onDelete: SetNull)

  @@unique([familyId, lemma])
  @@index([wordId])
}

model EnSet {
  id          String          @id @default(cuid())
  title       String
  description String          @default("")
  status      EnContentStatus @default(draft)
  listed      Boolean         @default(true)
  accessCode  String?
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  items       EnSetItem[]
  enrollments EnEnrollment[]

  @@index([status, sortOrder])
}

model EnSetItem {
  id       String   @id @default(cuid())
  setId    String
  senseId  String?
  position Int      @default(0)
  set      EnSet    @relation(fields: [setId], references: [id], onDelete: Cascade)
  sense    EnSense? @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@index([setId, position])
  @@index([senseId])
}

model EnEnrollment {
  id        String   @id @default(cuid())
  userId    String
  setId     String
  createdAt DateTime @default(now())
  set       EnSet    @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@unique([userId, setId])
  @@index([userId])
}

model EnReviewPreference {
  userId         String   @id
  selectedSetIds String[] @default([])
  initializedAt  DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model EnGuidedReviewSession {
  id                    String                   @id @default(cuid())
  userId                String
  activeKey             String?                  @unique
  selectedSetIds        String[]                 @default([])
  poolSenseIds          String[]                 @default([])
  remainingSenseIds     String[]                 @default([])
  currentChunkSenseIds  String[]                 @default([])
  chunkNumber           Int                      @default(1)
  phase                 String                   @default("study")
  studyPosition         Int                      @default(0)
  questionPosition      Int                      @default(0)
  startedAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  endedAt               DateTime?
  activeSeconds         Int                      @default(0)
  questions             EnGuidedReviewQuestion[]

  @@index([userId, startedAt])
}

model EnGuidedReviewQuestion {
  id          String                @id @default(cuid())
  sessionId   String
  chunkNumber Int
  kind        String                @default("main")
  position    Int
  senseId     String
  role        String
  activityKey String
  prompt      Json
  answerKey   String
  accepted    String[]              @default([])
  layout      Json?
  answer      String?
  correct     Boolean?
  responseMs  Int?
  answeredAt  DateTime?
  session     EnGuidedReviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, chunkNumber, kind, position])
  @@unique([sessionId, chunkNumber, kind, senseId])
  @@index([sessionId, chunkNumber, kind])
  @@index([sessionId, senseId])
}

model EnWordState {
  id             String    @id @default(cuid())
  userId         String
  senseId        String
  box            Int       @default(0)
  dueAt          DateTime  @default(now())
  lapses         Int       @default(0)
  introducedAt   DateTime  @default(now())
  lastReviewedAt DateTime?
  updatedAt      DateTime  @updatedAt
  sense          EnSense   @relation(fields: [senseId], references: [id], onDelete: Cascade)

  @@unique([userId, senseId])
  @@index([userId, dueAt])
}

model EnReview {
  id         String   @id @default(cuid())
  sessionId  String
  userId     String
  senseId    String
  at         DateTime @default(now())
  prompt     String
  correct    Boolean
  responseMs Int      @default(0)
  boxBefore  Int
  boxAfter   Int
  /// False for answers that did not move the schedule (in-session retries, answers before the due date).
  scheduled  Boolean  @default(true)

  @@index([userId, at])
  @@index([userId, senseId, at])
  @@index([sessionId])
}

model EnPracticeSession {
  id            String    @id @default(cuid())
  userId        String
  mode          EnRunMode
  setId         String?
  activityKey   String?
  senseIds      String[]  @default([])
  startedAt     DateTime  @default(now())
  endedAt       DateTime?
  activeSeconds Int       @default(0)

  @@index([userId, startedAt])
}

model EnTestAttempt {
  id          String       @id @default(cuid())
  userId      String
  mode        EnRunMode
  setId       String?
  blueprint   Json
  status      EnTestStatus @default(in_progress)
  startedAt   DateTime     @default(now())
  finishedAt  DateTime?
  wordCount   Int
  passedCount Int?
  items       EnTestItem[]

  @@index([userId, startedAt])
}

model EnLearnerProfile {
  userId            String    @id
  weeklyDaysGoal    Int       @default(4)
  /// Daily XP target. A change shows up in the next daily quest board.
  dailyXpGoal       Int       @default(400)
  /// Null until the learner picks a daily goal; drives the one-time goal picker.
  dailyGoalChosenAt DateTime?
  /// Highest level the learner has been congratulated for.
  seenLevel         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

/// XP ledger. Every source has a stable key, so a repeated answer, retake or replay never pays twice.
model EnXpEvent {
  id        String   @id @default(cuid())
  userId    String
  sourceKey String
  /// review | new (legacy) | longterm | extra | quiz | quest | goal | chest | achievement
  kind      String
  xp        Int
  /// Vietnam calendar day, YYYY-MM-DD.
  day       String
  at        DateTime @default(now())

  @@unique([userId, sourceKey])
  @@index([userId, day])
  @@index([userId, kind])
}

/// Quests fixed for one day or week, so targets do not move while the learner works on them.
model EnQuestBoard {
  userId    String
  /// daily | weekly
  period    String
  /// Day key, or the Monday day key for a week.
  periodKey String
  /// Array of { key, target, xp }.
  quests    Json
  createdAt DateTime @default(now())

  @@id([userId, period, periodKey])
}

model EnAchievement {
  userId     String
  /// Achievement id plus tier, e.g. memory_vault_2.
  key        String
  unlockedAt DateTime  @default(now())
  seenAt     DateTime?

  @@id([userId, key])
}

model EnTestItem {
  id          String        @id @default(cuid())
  attemptId   String
  senseId     String
  position    Int
  role        String
  activityKey String
  prompt      Json
  answerKey   String
  accepted    String[]      @default([])
  answer      String?
  correct     Boolean?
  responseMs  Int?
  answeredAt  DateTime?
  attempt     EnTestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, position])
  @@index([attemptId, senseId])
}
